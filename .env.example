# Copy this file to .env at the repository root and paste your real keys there.
# .env is ignored by Git. This example contains placeholders only.
# Restart the .NET services after editing .env. Existing OS environment variables
# and command-line arguments take precedence. Blank entries keep existing defaults.
# Values are literal: no shell execution or ${VARIABLE} interpolation is performed.

# AWS Bedrock duplicate comparison (server-side only).
DuplicateMatching__Bedrock__Enabled=false
DuplicateMatching__Bedrock__Region=ap-southeast-2
# Copy the model ID or inference profile ID from the Bedrock console.
DuplicateMatching__Bedrock__ModelId=
DuplicateMatching__Bedrock__ApiKey=
DuplicateMatching__Bedrock__MaxCallsPerCheck=5
DuplicateMatching__Bedrock__TimeoutSeconds=30

# Ollama enrichment: cloud web-search key and local extraction model.
Ollama__ApiKey=
Ollama__Model=qwen3:8b
Ollama__BaseUrl=http://127.0.0.1:11434

# Reserved for the Google Places API adapter, which is currently disabled.
GooglePlaces__ApiKey=

# Optional existing PostgreSQL/PostGIS database connection string.
# Leave blank to use the bundled Docker database and automatic local migrations.
LEADSFINDER_DB=

# Optional local source paths. Use single quotes to keep Windows backslashes literal.
# Geofabrik__ExtractPath='C:\maps\northern-zone-latest.osm.pbf'
# GoogleMapsScraper__ExecutablePath='C:\tools\google-maps-scraper.exe'
# GoogleMapsScraper__BrowserPath='C:\tools\.playwright'
