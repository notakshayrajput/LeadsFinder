# No .env file or API keys are required on this branch.
# Configure the API through this .env, appsettings.json, OS environment variables,
# or ASP.NET command-line arguments. OS variables and CLI arguments override .env.
#
# PowerShell examples:
# $env:Demo__CatalogSize = '10000000'
# $env:Demo__DataPath = 'C:\leadsfinder-data'
# $env:Demo__TickMilliseconds = '750'
# Provision the administrator before starting the API (no shared default password):
# $env:Demo__AdminEmail = 'your-admin@example.com'
# $env:Demo__AdminPassword = '<choose a unique password>'
# $env:Demo__AdminName = 'Administrator'
